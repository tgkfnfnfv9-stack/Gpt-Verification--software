<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.phase9</groupId>
  <artifactId>phase9-jforex-acquirer</artifactId>
  <version>1.0.0</version>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-08-29T00:00:00Z</project.build.outputTimestamp>
    <maven.compiler.release>8</maven.compiler.release>
    <jforex.client.version>3.6.51</jforex.client.version>
    <jforex.api.version>2.13.99</jforex.api.version>
  </properties>

  <repositories>
    <repository>
      <id>dukascopy-public</id>
      <url>https://www.dukascopy.com/client/jforexlib/publicrepo/</url>
      <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>com.dukascopy.dds2</groupId>
      <artifactId>DDS2-jClient-JForex</artifactId>
      <version>${jforex.client.version}</version>
      <exclusions>
        <exclusion>
          <groupId>com.dukascopy.api</groupId>
          <artifactId>JForex-API</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.dukascopy.api</groupId>
      <artifactId>JForex-API</artifactId>
      <version>${jforex.api.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>8</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <finalName>phase9-jforex-acquirer</finalName>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.phase9.Phase9JForexAcquirer</mainClass>
                  <manifestEntries>
                    <Premain-Class>org.phase9.RuntimeClassOriginGuard</Premain-Class>
                    <Can-Redefine-Classes>false</Can-Redefine-Classes>
                    <Can-Retransform-Classes>false</Can-Retransform-Classes>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
