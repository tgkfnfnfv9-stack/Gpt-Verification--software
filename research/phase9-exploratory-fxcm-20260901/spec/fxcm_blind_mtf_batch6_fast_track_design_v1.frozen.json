  "price_free_preaudit_decision": {
    "verdict": "BLOCK_FAST_TRACK_EXECUTION_PENDING_P0_RESOLUTION",
    "old_workflow_or_runner_reuse_allowed": false,
    "p0_findings": [
      {
        "id": "P0-CANDIDATE-323-FUTURE-AVAILABILITY",
        "closure_stage": "SCIENTIFIC_SPECIFICATION_BEFORE_IMPLEMENTATION",
        "finding": "The legacy scanner selects the month decision date from the presence of a completed same-day D1 bucket. At 08:00 UTC, that membership depends on H1 availability later in the same day. A 20-day return requires 21 closes, not 20. If 08:00 denotes the H1 bar open, its close is not available until 09:00, so the information cutoff and entry meaning are unresolved.",
        "required_resolution": "Before Count, prospectively freeze and test the first observed trading date, 20-return using exactly 21 prior completed closes, ATR inputs, the 08:00 information cutoff, the 09:00 close-availability boundary, and entry timing. Use only information available by the decision. If a causal rule cannot be fixed without outcome knowledge, retire candidate 323 without replacement."
      },
      {
        "id": "P0-EPISODE-SEMANTICS",
        "closure_stage": "SCIENTIFIC_SPECIFICATION_BEFORE_IMPLEMENTATION",
        "finding": "The frozen EARLIEST_SIGNAL_PER_OVERLAP_COMPONENT rule conflicts with the legacy extra UTC-date-plus-direction cross-instrument collapse and the greedy non-transitive overlap implementation.",
        "required_resolution": "Freeze one candidate-plus-instrument-plus-direction overlap-component definition, deterministic tie handling, and transitive component behavior before Count."
      },
      {
        "id": "P0-CANDIDATE-323-FREQUENCY-FEASIBILITY",
        "closure_stage": "SCIENTIFIC_SPECIFICATION_BEFORE_IMPLEMENTATION",
        "finding": "Only under common month-start dates and the legacy cross-instrument date-plus-direction collapse is the bound two primary episodes per month, normally at most 48 across 24 months before warm-up. Missing dates or symbol-specific dates change that bound. Under the corrected candidate-plus-instrument-plus-direction geometry, 8 instruments times 24 months equals 192 is only a coarse opportunity upper bound that ignores warm-up, missing observations, absent signals, and episode overlap; it is not a realizable Count bound, and feasibility of the frozen minimum 120 remains unproven.",
        "required_resolution": "Run a price-free opportunity-geometry proof against the prospectively corrected episode definition, including warm-up, missing-observation rules, signal opportunity rules, and episode overlap. Do not represent either 48 as an unconditional bound or 192 as a realizable Count bound, and do not lower the frozen threshold after Count."
      },
      {
        "id": "P0-MECHANISM-INDEPENDENCE",
        "closure_stage": "SCIENTIFIC_SPECIFICATION_BEFORE_IMPLEMENTATION",
        "finding": "Candidate 321 shares a 24-change and net-move structure with rejected 319, and candidate 324 is close to rejected fixed-16:00 stretch-reversal candidate 314. The recorded no-rescue declaration requires a documented independent-mechanism review.",
        "required_resolution": "Complete a pre-Count lineage decision using only provenance evidence demonstrably created before candidate freeze. If independence cannot be defended from that evidence without outcome knowledge, retire candidate 321 and/or 324 without replacement in this batch."
      },
      {
        "id": "P0-LEGACY-MTF-QC",
        "closure_stage": "SCIENTIFIC_SPECIFICATION_BEFORE_IMPLEMENTATION",
        "finding": "The anchored MTF report is structurally blocked: 4297 m1-derived-H1 versus direct-H1 OHLC mismatches, 4 m1-only timestamps, 69108 direct-H1-only timestamps, and an unproven provider schedule. The legacy Count identity check does not require structural QC pass.",
        "required_resolution": "Freeze a prospective execution amendment that keeps direct H1 canonical, treats cross-periodicity equality as a diagnostic only with explicit justification, requires exact final 64-series identity, and never calls the old report a structural QC pass."
      },
      {
        "id": "P0-COUNT-RUNTIME-ISOLATION",
        "closure_stage": "CONTROL_IMPLEMENTATION_AND_STATIC_AUDIT_AFTER_SEPARATE_APPROVAL",
        "finding": "The legacy v6 runner dynamically imports an incompletely hash-locked chain and reads a prior Return/OOS audit inside the Count process. The full checkout exposes Return code, prior results, Git metadata, and network-capable runtime surfaces.",
        "required_resolution": "Create a self-contained Count-only runner after separate approval, freeze its complete closure, mount no repository or prior results, disable network, and seal an exact-schema result after cleanup."
      },
      {
        "id": "P0-CLEANUP-AND-ATTESTATION",
        "closure_stage": "CONTROL_IMPLEMENTATION_AND_STATIC_AUDIT_AFTER_SEPARATE_APPROVAL",
        "finding": "The legacy workflow skips cleanup after partial acquisition failure and the runner self-reports zero persistent prices before cleanup occurs.",
        "required_resolution": "Use unconditional local cleanup for all terminal paths and produce the cleanup attestation only afterward with a trusted sealer."
      },
      {
        "id": "P0-INCOMPLETE-TRANSACTION-INPUT",
        "closure_stage": "CONTROL_IMPLEMENTATION_AND_STATIC_AUDIT_AFTER_SEPARATE_APPROVAL",
        "finding": "Metadata completeness of 2017 and 2018 does not make the ACQUIRING transaction canonical or authorize research use.",
        "required_resolution": "Freeze and separately approve the exact two-manifest and 32-archive read-only exception, including pre/post metadata identity and content SHA verification. Each archive must contain exactly 54 regular members: one payload manifest, one canonical CSV, and 52 source gzip members. Verify all 1664 source-member identities; reject unsafe paths, non-regular members, duplicate names, and unknown members."
      },
      {
        "id": "P0-VAULT-V2-DERIVED-COMPLETENESS",
        "closure_stage": "CONTROL_IMPLEMENTATION_AND_STATIC_AUDIT_AFTER_SEPARATE_APPROVAL",
        "finding": "The existing Vault V2 H4 and D1 completeness logic groups timestamps that are present and can therefore accept a 3-of-4 H4 bucket or a 23-of-24 D1 bucket as complete.",
        "required_resolution": "Independently generate the exact expected H1 timestamp set for every H4 and D1 bucket, require exact set equality, and drop plus count every incomplete bucket before Count."
      },
      {
        "id": "P0-CANDIDATE-324-COVERAGE-SEMANTICS",
        "closure_stage": "SCIENTIFIC_SPECIFICATION_BEFORE_IMPLEMENTATION",
        "finding": "Candidate 324 does not pre-fix whether its 96-hour window requires only endpoints or complete internal H1 coverage; those rules produce different signal universes.",
        "required_resolution": "Before Count, freeze endpoint-only or full-96-hour coverage with explicit missing-bar behavior. If this adds or changes the frozen candidate rule, permit it only through a prospective amended preregistration; otherwise retire candidate 324 without replacement."
      }
    ],
